{
  "name": "paper-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/validate-notes.mjs && vite build && node scripts/verify-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build:editor": "tsc --noEmit && vite build --mode editor && node scripts/bundle-editor.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.18.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "tw-animate-css": "^1.4.0"
  }
}
